# =============================================================================
# SIH26162 — Root Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=sih26162_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=sih26162_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sih26162_user:change_me_in_production@localhost:5432/sih26162_db

# --- NASA FIRMS API ---
# Get your API key at: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=your_nasa_firms_api_key_here
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# --- Application ---
SECRET_KEY=your_secret_key_here_change_in_production
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
DEBUG=true
